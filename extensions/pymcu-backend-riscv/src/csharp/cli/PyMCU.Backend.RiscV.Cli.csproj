<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>pymcuc-riscv</AssemblyName>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Must match the version pymcuc pulls in: Program.cs targets the 2.0.6 API. -->
    <PackageReference Include="System.CommandLine" Version="2.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lib\PyMCU.Backend.RiscV.csproj" />
  </ItemGroup>

</Project>
