<idea-plugin>
    <id>dev.begeistert.pymcu</id>
    <name>PyMCU</name>
    <version>0.1.0a1</version>
    <vendor email="begeistert@gmail.com" url="https://github.com/begeistert/pymcu">begeistert</vendor>

    <description><![CDATA[
        PyMCU support for PyCharm: run configurations, error highlighting, tool window,
        status bar chip indicator, automatic project sync, HAL type stubs,
        PlatformIO-style board selector, and AVR emulator debugger via XDebugger API.
        Licensed under Apache 2.0.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.python</depends>

    <extensions defaultExtensionNs="com.intellij">

        <applicationService
            serviceImplementation="dev.begeistert.pymcu.settings.PyMcuSettings"/>

        <notificationGroup id="PyMCU" displayType="BALLOON" isLogByDefault="true"/>

        <statusBarWidgetFactory
            id="PyMcuStatusBarWidget"
            implementation="dev.begeistert.pymcu.statusbar.PyMcuStatusBarWidgetFactory"
            order="last"/>

        <toolWindow
            id="PyMCU"
            anchor="left"
            factoryClass="dev.begeistert.pymcu.toolwindow.PyMcuToolWindowFactory"
            icon="/icons/pymcu.svg"/>

        <configurationType
            implementation="dev.begeistert.pymcu.run.PyMcuRunConfigurationType"/>

        <configurationType
            implementation="dev.begeistert.pymcu.debug.PyMcuDebugConfigurationType"/>

        <programRunner
            implementation="dev.begeistert.pymcu.debug.PyMcuDebugRunner"/>

        <consoleFilterProvider
            implementation="dev.begeistert.pymcu.console.PyMcuConsoleFilterProvider"/>

        <applicationConfigurable
            parentId="tools"
            instance="dev.begeistert.pymcu.settings.PyMcuSettingsConfigurable"
            id="dev.begeistert.pymcu.settings.PyMcuSettingsConfigurable"
            displayName="PyMCU"/>

        <directoryProjectGenerator
            implementation="dev.begeistert.pymcu.newproject.PyMcuProjectGenerator"/>

        <!-- Bundled type stubs + project compat dirs for import resolution -->
        <additionalLibraryRootsProvider
            implementation="dev.begeistert.pymcu.resolver.PyMcuAdditionalLibraryRootsProvider"/>

        <!-- Grey-out compile-time pruned branches (match __CHIP__.arch / .name) -->
        <annotator
            language="Python"
            implementationClass="dev.begeistert.pymcu.annotator.PyMcuBranchPruningAnnotator"/>

    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <runConfigurationProducer
            implementation="dev.begeistert.pymcu.run.PyMcuRunConfigurationProducer"
            order="last"/>
    </extensions>

    <applicationListeners>
        <listener
            class="dev.begeistert.pymcu.startup.PyMcuStartupActivity"
            topic="com.intellij.openapi.project.ProjectManagerListener"/>
    </applicationListeners>

    <actions>
        <action id="PyMcuStepInstruction"
                class="dev.begeistert.pymcu.debug.PyMcuStepInstructionAction"
                text="Step Instruction"
                description="Execute one AVR machine instruction (instruction-level step)"
                icon="/icons/step_instruction.svg">
            <keyboard-shortcut keymap="$default" first-keystroke="shift F7"/>
            <add-to-group group-id="XDebugger.ToolWindow.TopToolbar"
                          anchor="after"
                          relative-to-action="Debug.StepInto"/>
        </action>
    </actions>

</idea-plugin>
